# Copy this file to .streamlit/secrets.toml and fill in your tokens.
# secrets.toml is gitignored — never commit it.

[shopify.divotclub]
# The *.myshopify.com domain (NOT the public divotclub.store URL).
# Find it in Shopify admin → Settings → Domains (the "Primary domain" section
# shows it, or it's in the admin URL: https://admin.shopify.com/store/<this-part>.myshopify.com)
store_domain = "your-store.myshopify.com"

# From the app's Settings page in Shopify Dev Dashboard.
# Exchanged at runtime for a short-lived shpat_ token via client_credentials grant.
client_id = "REPLACE_ME"
client_secret = "REPLACE_ME"

# Shopify's stable API version (YYYY-MM). Bump quarterly as new versions release.
api_version = "2026-04"

[printify.divotclub]
# Personal access token from Printify → Connections
access_token = "REPLACE_ME"

# Leave blank on first run. scripts/test_connection.py will list all shops on
# this Printify account so you can paste the divotclub shop id here.
shop_id = ""
